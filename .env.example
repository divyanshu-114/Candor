# --- Multi-provider LLM layer -----------------------------------------------
# LLM_PROVIDERS is an ordered, comma-separated list. chat_json() tries them
# in order and fails over to the next one when a provider's daily quota is
# exhausted (never on a short per-minute limit -- that's worth waiting out
# on the same provider). A provider with no <NAME>_API_KEY set is skipped.
# No provider at all = degraded no-key mode (retrieval-only / extractive
# answers, see docs/DEVLOG.md).
LLM_PROVIDERS=groq,gemini
# Optional per-role order (falls back to LLM_PROVIDERS when unset). Strong
# prefers Groq's big model; fast prefers Gemini's lite model so routine
# calls don't eat the Groq strong-model budget.
LLM_PROVIDERS_STRONG=groq,gemini
LLM_PROVIDERS_FAST=gemini,groq

# Groq — get a free key at https://console.groq.com/keys
# (legacy GROQ_API_KEY/LLM_BASE_URL/LLM_MODEL_STRONG/LLM_MODEL_FAST names
# still work and are what "groq" falls back to if GROQ_BASE_URL/
# GROQ_MODEL_STRONG/GROQ_MODEL_FAST aren't set.)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Confirmed available on the Groq free tier as of 2026-10-01 (some older ids
# like llama-3.3-70b-versatile/llama-3.1-8b-instant return 404 depending on
# account tier; check https://console.groq.com/docs/models if these change)
GROQ_MODEL_STRONG=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b

# Gemini — get a free key at https://aistudio.google.com/apikey
# (OpenAI-compatible endpoint; used as a failover provider and, separately,
# as the judge model for score_memory.py --judge openai to save Groq quota)
# Confirmed available on this key as of 2026-10-02 via GET /models; the
# gemini-2.5-* ids are deprecated ("no longer available to new users") and
# the API itself suggests gemini-3.x replacements, which is what's below.
# gemini-3.8-flash (and other non-"lite" gemini-3.x models) default to a
# "thinking" mode that silently eats the whole max_tokens budget as hidden
# reasoning tokens (completion_tokens=0, content=None) unless
# `reasoning_effort` is passed -- every chat_json() call site in this repo
# already passes it, so this isn't something you need to set yourself, but
# if you add a new call site without it against Gemini, expect empty output.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Quota-aware roles: gemini-3.8-flash is capped at ~20 requests/day, so it
# must never serve routine calls. Gemini's STRONG role therefore uses the
# SAME flash-lite id as its FAST role; the capped model is only reachable
# through GEMINI_MODEL_PREMIUM, which nothing in the pipeline uses by default.
GEMINI_MODEL_STRONG=gemini-3.5-flash-lite
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
# GEMINI_MODEL_PREMIUM=gemini-3.8-flash

# Actions planner: both steps use the FAST role unless set to "strong".
# ACTIONS_STEP2_ROLE=fast

# --- Same-provider model fallback --------------------------------------------
# A daily quota is per MODEL. When a model hits its daily cap, calls move to the
# next model in its role's fallback list on the same key, then to the next
# provider. Defaults for Groq: the fast role falls back to the strong model and
# the strong role to the fast one. Comma separated; set empty to disable.
# GROQ_MODEL_FAST_FALLBACKS=openai/gpt-oss-120b
# GROQ_MODEL_STRONG_FALLBACKS=openai/gpt-oss-20b
# Freeze a role (cache hits still work, misses are NOT sent): LLM_FROZEN_ROLES=strong,fast
# Writer role (default fast) and actions follow-up role (default fast):
# WRITER_ROLE=fast
# ACTIONS_STEP2_ROLE=fast

# --- Any other OpenAI-compatible key -----------------------------------------
# If you have a key for a service that speaks the OpenAI chat API, set these
# and add the name ("custom" or "openai") to LLM_PROVIDERS (or to
# LLM_PROVIDERS_STRONG / LLM_PROVIDERS_FAST for one role only), e.g.
#   LLM_PROVIDERS=groq,gemini,custom
# A provider with no key (or, for "custom", no base URL / model id) is skipped.
# If you give only one model id it is used for both roles.
#
# "custom": any OpenAI-compatible endpoint.
#   CUSTOM_API_KEY=your_key_here
#   CUSTOM_BASE_URL=https://your-endpoint.example/v1
#   CUSTOM_MODEL_STRONG=your-bigger-model
#   CUSTOM_MODEL_FAST=your-smaller-model
#
# "openai": OpenAI itself (base URL defaults to https://api.openai.com/v1).
#   OPENAI_API_KEY=your_openai_key_here
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_MODEL_STRONG=your-bigger-model
#   OPENAI_MODEL_FAST=your-smaller-model
#
# Best effort: Anthropic's OpenAI-compatible endpoint can be used through
# "custom" (CUSTOM_BASE_URL=https://api.anthropic.com/v1/ with a Claude model
# id). It is not a first-class provider here and has not been tested with this
# code; Anthropic documents it as a compatibility layer, so some request
# fields may be ignored.
#
# Every provider gets the same treatment: a daily-quota error fails over to
# the next provider, a rejected key disables that provider, and optional
# request fields the endpoint doesn't accept (seed, reasoning_effort,
# response_format / JSON mode) are dropped automatically and the JSON is
# pulled out of the reply text instead.

# --- Cache and ledger ---------------------------------------------------------
# LLM responses are cached on disk (default .cache/llm). To measure a cold run
# WITHOUT deleting the warm cache, point this at a fresh directory:
# LLM_CACHE_DIR=.cache/llm_cold
# Real (non-cached) calls are appended to outputs/usage_ledger.jsonl; tests
# redirect it with USAGE_LEDGER_PATH so fake calls never land there.
# USAGE_LEDGER_PATH=outputs/usage_ledger.jsonl

# Legacy single-provider names (kept working; "groq" uses these as its own
# fallback defaults when GROQ_BASE_URL/GROQ_MODEL_STRONG/GROQ_MODEL_FAST
# aren't set -- see memory/llm.py).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_STRONG=openai/gpt-oss-120b
LLM_MODEL_FAST=openai/gpt-oss-20b

# Directory containing the data files (default shown)
DATA_DIR=./data
