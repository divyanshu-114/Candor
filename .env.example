# Candor memory: settings. Copy to .env and fill in ONE of the keys below. Nothing else is required.
#
# Which AI service answers? Set the key of the service you have; the program finds it automatically and
# picks a strong and a small model for you (it asks the service for its model list). If you set several keys,
# they are used in this order and each one takes over when the one before it runs out of credit or quota:
#   OpenAI -> OpenRouter -> your own (CUSTOM) -> Anthropic -> Groq -> Gemini
# No key at all also works: you get search and extractive answers only, and a loud notice says so.

# Optional: use only these services, in this order (otherwise every service with a key is used)
#LLM_PROVIDERS=openrouter,groq



GROQ_API_KEY=       <<<<<<Your_api_key>>>>>>>>

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_STRONG=openai/gpt-oss-120b
LLM_MODEL_FAST=openai/gpt-oss-20b
DATA_DIR=./data

# Second provider (OpenRouter) for provider checks; enable with LLM_PROVIDERS=groq,openrouter
OPENROUTER_API_KEY=   <<<<<Your_api_key>>>>>

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_STRONG=openai/gpt-oss-120b
OPENROUTER_MODEL_FAST=openai/gpt-oss-20b
